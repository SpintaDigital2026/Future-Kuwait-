# Copy this file to `.env` and fill in the values.
#
# The SUPABASE_* and VITE_SUPABASE_* pairs hold the same values. The VITE_
# prefixed copies are inlined into the client bundle; the unprefixed copies are
# read by server-side code. Both use the *publishable* key, which is safe to
# expose — table access is governed by row level security.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Server-only. Bypasses row level security, so never expose it to the client
# and never commit it. Required by src/integrations/supabase/client.server.ts.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional, and normally left empty. Images ship in the repo under
# public/__l5e/assets-v1/, so the pointer URLs in src/assets/**/*.asset.json
# resolve from disk. Set this only if you add new assets in Lovable that aren't
# local yet: it activates the dev-server proxy in
# @lovable.dev/vite-tanstack-config, which takes priority over public/ and
# fetches over the network. Format: id-preview--<project-id>.lovable.app
LOVABLE_PREVIEW_HOST=""
