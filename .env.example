# Copy this file to `.env` and fill in the values.
#
# The SUPABASE_* and VITE_SUPABASE_* pairs hold the same values. The VITE_
# prefixed copies are inlined into the client bundle; the unprefixed copies are
# read by server-side code. Both use the *publishable* key, which is safe to
# expose — table access is governed by row level security.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Optional, **server-only**. Bypasses row level security — never expose it
# to the client and never commit it. Required only for creating admin users
# from the app (src/integrations/supabase/client.server.ts).
SUPABASE_SERVICE_ROLE_KEY=""

# Production: leave empty. Images ship in public/__l5e/assets-v1/.
LOVABLE_PREVIEW_HOST=""

# Optional. If set, messages and booked calls are emailed here.
# Accepting a booking email adds the call to the calendar.
# RESEND_API_KEY=""
# CONTACT_INBOX_EMAIL="inquiry@fcc-solutions.co.uk"
# CONTACT_FROM_EMAIL="FCC Website <noreply@fcc-solutions.co.uk>"
